generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // Deixamos apenas o provider aqui
}

// O modelo de produto continua igual
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}
