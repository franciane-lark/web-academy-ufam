<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Listagem de Produtos</h2>
  <a href="/produto/create" class="btn btn-dark">＋</a>
</div>

<table class="table table-striped align-middle">
  <thead>
    <tr>
      <th>Nome</th>
      <th style="width: 150px;">Preço (R$)</th>
      <th style="width: 150px;" class="text-end">Opções</th>
    </tr>
  </thead>
  <tbody>
    {{#each produtos}}
    <tr>
      <td>{{this.nome}}</td>
      <td>{{this.preco}}</td>
      <td class="text-end">
        <a href="/produto/view/{{this.id}}" class="btn btn-sm btn-link text-dark" title="Visualizar">👁</a>
        <a href="/produto/update/{{this.id}}" class="btn btn-sm btn-link text-dark" title="Editar">✏️</a>
        <form action="/produto/delete/{{this.id}}" method="POST" class="d-inline" onsubmit="return confirm('Deseja mesmo excluir este produto?')">
          <button type="submit" class="btn btn-sm btn-link text-dark" title="Excluir">🗑</button>
        </form>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>